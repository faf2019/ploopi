# Modèle du fichier .env de docker-compose.prod.yml : le copier à la racine du dépôt
# (cp docker/env.prod.modele .env) puis le renseigner. .env n'est pas versionné.

# Nom de domaine public, pointant (DNS) vers ce serveur ; ports 80 et 443 ouverts.
PLOOPI_DOMAIN=ploopi.example.org

# Mots de passe de la base : longs et aléatoires (openssl rand -base64 24).
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Version de PHP de l'image : 8.5 (défaut) ou 8.2.
PHP_VERSION=8.5
