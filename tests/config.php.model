return array(

    /**
     * Instance à éprouver. Elle doit servir le dépôt courant : la suite compare le code
     * source et le comportement observé.
     */
    'base_url'          => 'http://127.0.0.1:8080',

    /**
     * Base de données de cette instance.
     */
    'db_host'           => '127.0.0.1',
    'db_name'           => 'ploopi',
    'db_user'           => 'ploopi',
    'db_pass'           => '',

    /**
     * Compte administrateur système utilisé pour la connexion.
     */
    'admin_login'       => 'admin',
    'admin_password'    => '',

    /**
     * Dossier des fichiers de session PHP du serveur web, si le gestionnaire "php" est en
     * usage. Laisser vide pour une détection automatique. Les deux contrôles qui lisent le
     * fichier de session sont signalés "non évalué" si le dossier est introuvable.
     */
    'session_path'      => '',

    /**
     * Fichier où le serveur web consigne les courriels au lieu de les expédier
     * (sendmail_path = "sh tests/sendmail.sh <fichier>", ce que fait tests/instance.sh).
     * Vide : les contrôles qui lisent un courriel sont signalés "non évalué".
     */
    'courriels'         => '',

    /**
     * Autorise la suite 04, qui est DESTRUCTIVE : elle retire temporairement
     * config/config.php, déroule une installation neuve par l'assistant, puis supprime la
     * base créée. À n'activer que sur une instance jetable.
     */
    'allow_destructive' => false,

    /**
     * Base créée puis supprimée par la suite 04. Doit différer de db_name.
     */
    'install_db'        => 'ploopi_verif_installation',

);
