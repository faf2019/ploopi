{
    "name": "ovensia/ploopi",
    "description": "Ploopi - plateforme de gestion web - contenus, wiki, documents, planning",
    "version": "1.9.8",
    "keywords": ["PHP","ploopi","cms","content management system","editor","documents","planning","agenda","booking","wiki","webedit","forms","dbreport"],
    "homepage": "http://www.ploopi.org",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Stéphane Escaich"
        },
        {
            "name": "Audrey Gilbert"
        }
    ],
    "repositories": [
        {
            "type":"package",
            "package": {
              "name": "eastdesire/jscolor",
              "version":"2.5.1",
              "source": {
                  "url": "https://github.com/EastDesire/jscolor",
                  "type": "git",
                  "reference":"master"
                }
            }
        }
    ],
    "require": {
        "aws/aws-sdk-php": "^3.337",
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "ext-curl": "*",
        "ext-mysqli": "*",
        "ext-xml": "*",
        "ext-mbstring": "*",
        "ext-memcached": "*",
        "donatj/phpuseragentparser": "^0.5.1",
        "phpoffice/phpspreadsheet": "^1.8.2",
        "netcarver/textile": "^4.1.5",
        "ezyang/htmlpurifier": "^4.8",
        "openlss/lib-array2xml": "^0.0.10",
        "wamania/php-stemmer": "^4.0",
        "pear/http_request2": "^2.3",
        "horde/text_diff": "*",
        "components/jquery": "^3.1",
        "components/jqueryui": "^1.12",
        "components/highlightjs": "^9.5",
        "eastdesire/jscolor": "2.5.1",
        "pear/net_smtp": "^1.8",
        "pear/mail": "^1.4",
        "pear/mail_mime": "^1.10",
        "dompdf/dompdf": "^3.1",
        "tinymce/tinymce": "^8.9",
        "mklkj/tinymce-i18n": "^26.9"
    },
    "autoload": {
        "exclude-from-classmap": ["vendor/horde/exception/compat/"]
    },
    "config": {
        "platform": { "php": "8.1.0" }
    },
    "scripts": {
        "post-create-project-cmd": [
            "cp .htaccess_modele .htaccess"
        ]
    }
}
